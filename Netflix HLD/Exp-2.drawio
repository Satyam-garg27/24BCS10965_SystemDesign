        <mxCell id="FbkpsqWfTf4dM5n_krLs-62" parent="1" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=light-dark(#000000,#000000);align=left;verticalAlign=top;labelBackgroundColor=light-dark(#FFFFFF,#FFFFFF);fillColor=light-dark(#FFFFFF,#FFFFFF);" value="&lt;h3 class=&quot;PDq2pG_selectionAnchorContainer&quot;&gt;Functional Requirements&lt;span aria-hidden=&quot;true&quot; class=&quot;PDq2pG_selectionAnchor&quot;&gt;&lt;/span&gt;&lt;/h3&gt;&lt;br&gt;&lt;div class=&quot;group TyagGW_tableContainer TyagGW_tableContainerWithTableOfContents&quot;&gt;&lt;div tabindex=&quot;-1&quot; class=&quot;TyagGW_tableWrapper flex flex-col-reverse w-fit&quot;&gt;&lt;table class=&quot;w-fit min-w-(--thread-content-width)&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;last:pe-10&quot;&gt;Module&lt;/th&gt;&lt;th class=&quot;last:pe-10&quot;&gt;Requirements&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;Subscription&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;Signup, Login, Payment, Paywall&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;Content&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;Classification, Genres, Trending, Watchlist&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;History&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;Watch History, Completion Status, Continue Watching&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;Search&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;Search Bar, Content Search, Recommendations&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;Player&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;Resolution, Playback Speed, Languages, Subtitles&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;&lt;br&gt;&lt;h3&gt;Non-Functional Requirements&lt;/h3&gt;&lt;h3&gt;&lt;br style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;&lt;div class=&quot;group TyagGW_tableContainer TyagGW_tableContainerWithTableOfContents&quot; style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;&lt;div tabindex=&quot;-1&quot; class=&quot;TyagGW_tableWrapper flex flex-col-reverse w-fit&quot;&gt;&lt;table class=&quot;w-fit min-w-(--thread-content-width)&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th class=&quot;last:pe-10&quot;&gt;Requirement&lt;/th&gt;&lt;th class=&quot;last:pe-10&quot;&gt;Goal&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;Scalability&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;Handle millions of users&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;Availability&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;99.9%+ uptime&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;Low Latency&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;Fast API/Search response&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;Reliability&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;Smooth, low-buffer video playback&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;Fault Tolerance&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;No single point of failure&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;Security&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;Secure auth, data &amp;amp; payments&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;Durability&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;No loss of user/content data&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;strong&gt;Global Access&lt;/strong&gt;&lt;/td&gt;&lt;td&gt;CDN-based worldwide delivery&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;&lt;/h3&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div class=&quot;group TyagGW_tableContainer TyagGW_tableContainerWithTableOfContents&quot;&gt;&lt;/div&gt;" vertex="1">
